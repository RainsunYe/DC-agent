# LLM configuration. Never commit a real key.
export OPENAI_API_KEY=""
export OPENAI_MODEL="gpt-5.6-sol"
export OPENAI_API_BASE="https://api.openai.com/v1"

# Local EDA configuration. dc_shell and iverilog must be available on PATH.
export YOSYS_BIN="yosys"

# If iverilog is not already on PATH, uncomment and edit this line.
# export PATH="/path/to/iverilog/bin:$PATH"

# Optional path overrides.
export DC_AGENT_DESIGN_CSV="$PWD/configs/design_summary.csv"
export DC_AGENT_WORK_DIR="$PWD/work"
