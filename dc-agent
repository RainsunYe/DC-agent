#!/usr/bin/env bash
set -euo pipefail

release_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"

if [[ -z "${CONDA_PREFIX:-}" || ! -x "${CONDA_PREFIX}/bin/python" ]]; then
    echo "Error: activate the DC Agent Conda environment before running dc-agent." >&2
    echo "See README.md for environment setup instructions." >&2
    exit 1
fi

python_version="$(${CONDA_PREFIX}/bin/python -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')"
if [[ "${python_version}" != "3.10" ]]; then
    echo "Error: dc-agent requires Python 3.10; the active environment uses Python ${python_version}." >&2
    exit 1
fi

python_dir="${CONDA_PREFIX}/lib/python3.10"
export PYTHONHOME="${CONDA_PREFIX}"
export LD_LIBRARY_PATH="${CONDA_PREFIX}/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
export NUITKA_PYTHONPATH="${release_dir}:${python_dir}:${python_dir}/lib-dynload:${python_dir}/site-packages"
export PYTHONPATH="${NUITKA_PYTHONPATH}${PYTHONPATH:+:${PYTHONPATH}}"

exec "${release_dir}/dc-agent.bin" "$@"
